{
  "name": "dsfr-ai-components",
  "description": "Système de Design de l'État (DSFR) component registry for AI coding agents. Self-contained, accessible French government components with full adaptation and coordination metadata.",
  "repo": "https://github.com/ednark/dsfr-ai-components",
  "base": "https://raw.githubusercontent.com/ednark/dsfr-ai-components/main",
  "count": 42,
  "facetsUrl": "https://raw.githubusercontent.com/ednark/dsfr-ai-components/main/infinite/facets.json",
  "index": "https://raw.githubusercontent.com/ednark/dsfr-ai-components/main/infinite/components.index.json",
  "indexSchemaVersion": 1,
  "metadataSchemaVersion": 2,
  "tileFetchPattern": "https://raw.githubusercontent.com/ednark/dsfr-ai-components/main/infinite/{file}",
  "designSystem": {
    "name": "Système de Design de l'État (DSFR)",
    "version": "1.15"
  },
  "agentMetaId": "dsfr-agent-meta",
  "tileDir": "infinite",
  "facets": [
    "dsfrComponentType",
    "section",
    "variant",
    "requiresJs",
    "interaction",
    "a11y",
    "govCompliance",
    "costTier",
    "compositionRecipes",
    "piiHandling",
    "touchTargetSize",
    "supportedTokenProfiles"
  ],
  "flow": [
    "GET agents.json",
    "GET facets.json",
    "GET components.index.json",
    "filter by facet in code",
    "GET tile by file",
    "read dsfr-agent-meta block"
  ],
  "recipesUrl": "https://raw.githubusercontent.com/ednark/dsfr-ai-components/main/infinite/recipes/index.json",
  "versionsUrl": "https://raw.githubusercontent.com/ednark/dsfr-ai-components/main/infinite/versions.json",
  "compatibilityUrl": "https://raw.githubusercontent.com/ednark/dsfr-ai-components/main/compatibility.json",
  "compatibilityTargets": [
    "uswds",
    "govuk"
  ],
  "mcp": {
    "enabled": true,
    "server": "_base/mcp/server.mjs",
    "transport": "stdio",
    "tools": [
      "search_components",
      "get_component",
      "list_facets",
      "get_index",
      "get_adapter",
      "translate_component",
      "get_recipe",
      "query_compliance",
      "get_versions"
    ]
  },
  "compatibilityPath": "compatibility.json",
  "updated": "0.1.0",
  "language": "fr"
}